<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="2" author="ranim">
        <createTable tableName="donnees_facture">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="document_id" type="bigint">
                <constraints foreignKeyName="fk_document" references="document(id)"/>
            </column>
            <column name="num_facture" type="varchar(100)"/>
            <column name="fournisseur" type="varchar(255)"/>
            <column name="montant_ht" type="decimal(10,2)"/>
            <column name="montant_ttc" type="decimal(10,2)"/>
            <column name="score_confiance" type="decimal(5,2)"/>
        </createTable>
    </changeSet>
</databaseChangeLog>